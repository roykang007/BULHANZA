rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Catch-all default deny gate
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for validation
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedAdmin() {
      return isSignedIn() &&
             request.auth.token.email == "roykang007@gmail.com";
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Site settings matching rules
    match /site_settings/{settingsId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Archive items matching rules
    match /archive_items/{itemId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Artists matching rules
    match /artists/{artistId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }
  }
}
